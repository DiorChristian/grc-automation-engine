# AWS Region Configuration ☁️
AWS_REGION=us-east-1

# SQS Queue URLs 📥
STANDARD_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/standard-queue
HIGH_PRIORITY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/high-priority-queue
DLQ_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/dlq-queue

# S3 WORM Audit Vault 🔒
WORM_VAULT_BUCKET=your-worm-audit-vault-bucket